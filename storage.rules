rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthorizedAdmin() {
      return request.auth != null && (
        request.auth.uid == "ADMIN_UID_PLACEHOLDER" ||
        request.auth.token.admin == true
      );
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)') &&
             request.resource.size <= 10 * 1024 * 1024;
    }

    function isPDF() {
      return request.resource.contentType == 'application/pdf' &&
             request.resource.size <= 20 * 1024 * 1024;
    }

    // Products Folder
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && (isImage() || isPDF());
    }

    // Projects Folder
    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isImage();
    }

    // Documents & Certifications Folder
    match /documents/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isPDF();
    }

    match /certifications/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && (isImage() || isPDF());
    }

    // Gallery & General Media
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && isImage();
    }

    match /company/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() && (isImage() || isPDF());
    }
  }
}
